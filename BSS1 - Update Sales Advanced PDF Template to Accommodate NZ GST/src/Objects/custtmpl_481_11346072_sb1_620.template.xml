           	padding: 4px 6px;
            border-color: #333333;
        }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0;
            font-size: 10pt;
        }
      	table.top{
          	table-layout: fixed;
        }
      	td.head{
          	width:48%;
          	font-size: 15pt;
          	font-weight: bold;
            <#if subsidiary.id == "4" || subsidiary.id == "3" || subsidiary.id == "2">
            background-color:rgb(237, 28, 36);
          	color:white;
            <#else></#if>
        }
      	td.address{
          	width:20%;
        }
      	td.logo{
          	width:28%;
        }
      	td.head1{
          	width: 16%;
          	font-weight: bold;
          	font-size: 8pt;
          	padding-top: 6px;
            padding-bottom: 2px;
          	border: 0.01px solid;
          	border-top-color: #9e9e9e;
          	border-left-color: white;
          	border-right-color: #9e9e9e;
          	border-bottom-color: #9e9e9e;
        }
      	td.head2{
          	width: 28%;
          	font-size: 8pt;
          	padding-top: 6px;
            padding-bottom: 2px;
          	border: 0.01px solid;
          	border-top-color: #9e9e9e;
          	border-right-color: white;
          	border-left-color: #9e9e9e;
          	border-bottom-color: #9e9e9e;
        }
        table.footer td {
            padding: 0;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
			border: 0.01px solid #9e9e9e;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
      	td.addressheader {
            font-size: 8pt;
            padding: 12px;
            background-color: #f1f1f1;
          	height: 95px;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        table.pmtmethod {
            padding-top: 35px;
            page-break-inside: avoid;
        }
        td.sectionhead {
            font-weight: bold;
            font-size: 8pt;
            <#if subsidiary.id == "4" || subsidiary.id == "3" || subsidiary.id == "2">
				background-color:rgb(237, 28, 36);
				color:white;
            <#elseif subsidiary.id == "6" || subsidiary.id == "7" || subsidiary.id == "10">
				background-color:#1d1645;
				color:white;
			<#else></#if>
            border-color: #f1f1f1;
        }
        th.itemname{
          	border: 1px solid black;
            border-collapse: collapse;
        }
        td.itemname{
          	border: 1px solid black;
   			border-collapse: collapse;
        }
      	tr.itemline1{
          	border: 0.01px solid #9e9e9e;
          	text-align: center;
          	margin-bottom:-10%;
        }
      	tr.itemline2{
          	border: 0.01px solid #9e9e9e;
          	text-align: center;
          	margin-bottom:-10%;
        }
      	td.itemtable2{
          	border: 0.01px solid #9e9e9e;
          	text-align: center;
          	margin-bottom:-10%;
        }
      	td.subtotal{
          	border: 0.01px solid #9e9e9e;
          	border-collapse: collapse;
          	font-size: 8pt;
        }
      	td.bottomright1{
          	border: 0.01px solid;
          	border-top-color: #9e9e9e;
          	border-left-color: white;
