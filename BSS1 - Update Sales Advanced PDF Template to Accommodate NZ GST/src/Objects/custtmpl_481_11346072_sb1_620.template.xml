<head>
<#if .locale == "ru_RU"><link name="verdana" type="font" subtype="opentype" src="${nsfont.verdana}" src-bold="${nsfont.verdana_bold}" bytes="2" /></#if>
    <macrolist>
        <macro id="nlheader">
			<table class="top" style="width:100%">
				<tr>
					<td class="head" colspan="2" rowspan="1"><#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "true">PROFORMA INVOICE<#else>SALES ORDER</#if></td>
					<td colspan="1" rowspan="6" style="width:4%;">&nbsp;</td>
					<td class="address" colspan="1" rowspan="6">
					<span class="paddingbold" style="font-size: 7pt;">${subsidiary.legalname}</span><br /><span class="padding" style="font-size: 6pt;">ABN ${subsidiary.federalidnumber}<#if record.currencysymbol == "NZD" && record.shipcountry == "NZ" && record.billcountry == "NZ"><br />NZ GST Registration Number : <br />148-889-414</#if><br /><br />${subsidiary.returnaddress_text}<br />${subsidiary.custrecord_phone}<br />${subsidiary.email}<br />${record.subsidiary.url}<br /><br /><#if !(record.currencysymbol == "NZD" && record.shipcountry == "NZ" && record.billcountry == "NZ")>NDIS# 4050087969</#if></span></td>
						<td class="logo" colspan="1" rowspan="6">
                        <#if subsidiary.logo?length != 0 >
							<img src="${subsidiary.logo@url}" class="logo" />
						<#elseif companyInformation.logoUrl?length != 0 >
							<img src="${companyInformation.logoUrl}" class="logo" />
						</#if>
                        </td>
				</tr>
				<tr>
					<td colspan="2" rowspan="1">&nbsp;</td>
				</tr>
				<!-- <tr>			
					<td class="head1"><span class="padding">NUMBER:</span></td>
					<td class="head2"><span class="padding">${record.tranid?replace("SO", "PI")}</span></td>
				</tr> -->
				<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "true">
    				<tr>			
        				<td class="head1"><span class="padding">NUMBER:</span></td>
        				<td class="head2"><span class="padding">${record.tranid?replace("SO", "PI")}</span></td>
    				</tr>
					<tr>
						<td class="head1"><span class="padding">DATE:</span></td>
						<td class="head2"><span class="padding">${record.trandate}</span></td>
					</tr>
				<#else>
					<tr>			
        				<td class="head1"><span class="padding">SO NUMBER:</span></td>
    					<td class="head2"><span class="padding">${record.tranid}</span></td>
    				</tr>

					<tr>
						<td class="head1"><span class="padding">SO DATE:</span></td>
						<td class="head2"><span class="padding">${record.trandate}</span></td>
					</tr>
				</#if>

				
				<!-- <tr>
					<td class="head1"><span class="padding">DATE:</span></td>
					<td class="head2"><span class="padding">${record.trandate}</span></td>
				</tr> -->
				<tr>
					<td class="head1"><span class="padding">CUSTOMER ORDER NO:</span></td>
					<td class="head2"><span class="padding">${record.otherrefnum}</span><br />&nbsp;</td>
				</tr>
				<tr>
					<td class="head1"><span class="padding">TERMS:</span></td>
					<td class="head2"><span class="padding">${record.terms} / ${record.currency}</span></td>
				</tr>
				<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "false">
				<tr>
				
					<td class="head1"><span class="padding">DUE DATE:</span></td>
					<td class="head2"><span class="padding">${record.enddate}</span></td>
					<td>&nbsp;</td>
				
				<!-- <#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "false"> -->
					<td class="head1"><span class="padding">CON NOTE NO:</span></td>
					<td class="head2"><span class="padding">${record.createdfrom.custbody_connote}</span></td>
				<!-- <#else>
					<td><span>&nbsp;</span></td>
					<td><span>&nbsp;</span></td>
				</#if> -->
				</tr>
				</#if>
				<tr>
					<td class="head1"><span class="padding">ACCOUNT NUMBER:</span></td>
					<td class="head2"><span class="padding">${record.entity.entityid}</span></td>
					<td>&nbsp;</td>
					<td class="head1"><span class="padding">CONTACT:</span></td>
					
					<td class="head2"><span class="padding">${record.salesrep}</span></td>
				</tr>
				<tr>
				<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "false">
					<td class="head1"><span class="padding">DESPATCH METHOD:</span></td>
					<td class="head2"><span class="padding">${record.custbody280}</span></td>
				<#else>
					<td><span>&nbsp;</span></td>
					<td><span>&nbsp;</span></td>
				</#if>
					<td>&nbsp;</td>
					<td class="head1"><span class="padding">CONTACT EMAIL:</span></td>
					<td class="head2"><span class="padding">${record.salesrep.email}</span></td>
				</tr>
			</table>
        </macro>
		<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "true">
		<macro id="nlfooter">
			<table class="footer" width="100%">
				<tr>
					<td align="center">Proforma Invoice only - not valid for GST claims.</td>
				</tr>
			</table>
		</macro>
		</#if>
    </macrolist>
    <style type="text/css">table {
