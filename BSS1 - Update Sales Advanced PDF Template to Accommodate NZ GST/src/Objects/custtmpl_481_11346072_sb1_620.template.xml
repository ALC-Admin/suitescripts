<body header="nlheader" header-height="23%" footer="nlfooter" footer-height="10pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table class="addressheader" style="width: 100%;">
		<tr>
			<td class="addressheader" colspan="1" rowspan="4" style="width: 48%;color:#4d4d4d;"><span class="padding" style="font-weight: bold;">INVOICE TO</span><br /><span>${record.billaddress}</span></td>
			<td colspan="1" rowspan="4" style="width: 4%;">&nbsp;</td>
			<td class="addressheader" colspan="1" rowspan="4" style="width: 48%;color:#4d4d4d;"><span class="padding" style="font-weight: bold;">DELIVER TO</span><br /><span>${record.shipaddress}<br/>${record.shipphone}  </span></td>
		</tr>
	</table>

	<table style="width: 100%;">
		<tr>
			<td>&nbsp;</td>
		</tr>
	</table>
	<#if record.item?has_content>

		<table style="width: 100%;"><!-- start items -->
  
		<#list record.item as item><#if item_index==0>
			<thead>
				<tr class="itemline1">
					<th class="itemtable1" line-height="150%" width="70px"><p align="center">CODE</p></th>
					<th class="itemtable2" line-height="150%" width="250px"><p align="center">DESCRIPTION</p></th>
					<th align="center" class="itemtable2" line-height="150%" width="70px"><p align="center">QTY ORDERED</p></th>
					<th align="center" class="itemtable2" line-height="150%" width="70px"><p align="center">UNIT PRICE</p></th>
					<th align="center" class="itemtable2" line-height="150%" width="70px"><p align="center"><#if record.currencysymbol == "NZD" && record.shipcountry == "NZ" && record.billcountry == "NZ">GST (NZ)<#else>GST</#if></p></th>
					<th align="center" class="itemtable3" line-height="150%" width="80px"><p align="center">AMOUNT EX GST</p></th>
				</tr>
			</thead>
		</#if>
		<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "false">
			<tr class="itemline2">
				<td class="itemtable1" width="70px"><p align="center">${item.custcol_itemname}</p></td>
				<td class="itemtable2" width="250px"><p align="left">${item.description}</p></td>
				<td class="itemtable2" width="70px"><p align="center"><#setting number_format=",##0.##">${item.quantity}</p></td>
				<td class="itemtable2" width="70px"><p align="center"><#setting number_format=",##0.00">$${item.rate}</p></td>
				<td class="itemtable2" width="70px"><p align="right"><#setting number_format=",##0.00">$${item.rate*item.taxrate1}</p></td>
				<td class="itemtable3" width="80px"><p align="right"><#setting number_format=",##0.00">$${item.amount}</p></td>
			</tr>
		<#else>

		<#assign amountStr = item.amount?replace("[\\$,]", "", "r")>
			<#assign amountNum = amountStr?number>
				<#if amountNum gt 0>
					<tr class="itemline2">
						<td class="itemtable1" width="70px">
							<#if item.itemtype = "ShipItem">Freight
								<#elseif item.item.externalid = "724053">Freight
								<#elseif item.item.externalid = "1582478">Freight
								<#else>${item.custcol_itemname}				
							</#if>
						</td>
						<td class="itemtable2" width="250px"><p align="left">${item.description}</p></td>
						<td class="itemtable2" width="70px"><p align="center"><#setting number_format=",##0.##">${item.quantity}</p></td>
						<td class="itemtable2" width="70px"><p align="center"><#setting number_format=",##0.00">$${item.rate}</p></td>
						<td class="itemtable2" width="70px"><p align="right"><#setting number_format=",##0.00">$${item.rate*item.taxrate1}</p></td>
						<td class="itemtable3" width="80px"><p align="right"><#setting number_format=",##0.00">$${item.amount}</p></td>
					</tr>
				</#if>
			</#if>
		</#list>
		<!-- end items --></table>
	</#if>
  
 	<!-- <#if record.expense?has_content></#if>
  		<#if record.custbody_alcq_prnt_proforma_inv = true >
    		<table align="right" class="subtotal" style="width:39%;">
				<tr>
					<td align="right" class="subtotal" width="121px"><p style="font-weight: bold;">SUB TOTAL:</p></td>
					<td align="right" class="subtotal">${record.subtotal}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">${record.taxtotal@label}</p></td>
					<td align="right" class="subtotal">${record.taxtotal}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">TOTAL:</p></td>
					<td align="right" class="subtotal">${record.total}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">DEPOSIT REQUIRED:</p></td>
					<td align="right" class="subtotal">${record.custbody188}</td>
				</tr>
			</table>
    	</#if>  -->
  
  		<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "true">
    		<table class="pmtmethod" style="width:100%; table-layout: fixed;">
        		<tr>
            		<td class="sectionhead" style="width:48%;" colspan="2" rowspan="1">PAYMENT METHODS</td>
            		<td style="width:4%;" colspan="1" rowspan="1">&nbsp;</td>
            		<td class="sectionhead" style="width:48%;" colspan="2" rowspan="1">SUMMARY</td>
        		</tr>
        		<tr>
            		<td colspan="2">
                		<table style="width:100%">
                    		<tr style="padding-top: 5px;">
                        		<td><b>EFT and Direct Debit</b></td>
                    		</tr>
                    		<tr style="padding-top: 3px;">
                    		    <td class="bankdetail1">ACCOUNT NAME : <b>${subsidiary.legalname}</b></td>
                    		</tr>
                    		<tr>
                    		    <td class="bankdetail1">BSB : <#if record.currency != "US Dollar"><b>${subsidiary.custrecord_bsb}</b><#else><b>${subsidiary.custrecord_us_bsb}</b></#if></td>
                    		</tr>
                    		<tr>
                    		    <td class="bankdetail1">ACCOUNT NO : <#if record.currency != "US Dollar"><b>${subsidiary.custrecord_account}</b><#else><b>${subsidiary.custrecord_us_account}</b></#if></td>
                    		</tr>
                		</table>
            		</td>
            		<td colspan="1">&nbsp;</td>
            		<td colspan="2">
            		    <table style="width:80%; table-layout: fixed; align: right;">
            		            <tr>
            		                <td align="right" class="subtotal"><p style="font-weight: bold;">SUB TOTAL:</p></td>
            		                <td align="right" class="subtotal">${record.subtotal}</td>
            		            </tr>
            		            <tr>
            		                <td align="right" class="subtotal"><p style="font-weight: bold;">${record.taxtotal@label}</p></td>
            		                <td align="right" class="subtotal">${record.taxtotal}</td>
            		            </tr>
            		            <tr>
            		                <td align="right" class="subtotal"><p style="font-weight: bold;">TOTAL:</p></td>
            		                <td align="right" class="subtotal">${record.total}</td>
            		            </tr>
								 <tr>
            		                <td align="right" class="subtotal"><p style="font-weight: bold;">DEPOSIT REQUIRED:</p></td>
            		                <td align="right" class="subtotal">${record.custbody_depositpercent}</td>
            		            </tr>
            		            <tr>
            		                <td align="right" class="subtotal"><p style="font-weight: bold;">AMOUNT DUE:</p></td>
            		                <td align="right" class="subtotal">                                     
                                     <#assign percent = record.custbody_depositpercent?replace("%", "")?number />
                                     <#assign totalNumber = record.total?replace(",", "")?number />
                                     <#assign amountDue = (totalNumber * percent / 100)?string["#,##0.00"] />
                                    ${amountDue}</td>
            		            </tr>
            		    </table>
            		</td>
        		</tr>
    		</table>
		<#else>

		<#if record.custbody_alcq_prnt_proforma_inv = false >
		    <table align="right" class="subtotal" style="width:39%;">
				<tr>
					<td align="right" class="subtotal" width="121px"><p style="font-weight: bold;">SUB TOTAL:</p></td>
					<td align="right" class="subtotal">${record.subtotal}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">${record.taxtotal@label}</p></td>
					<td align="right" class="subtotal">${record.taxtotal}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">TOTAL:</p></td>
					<td align="right" class="subtotal">${record.total}</td>
				</tr>
				<tr>
					<td align="right" class="subtotal"><p style="font-weight: bold;">AMOUNT DUE:</p></td>
					<td align="right" class="subtotal">${record.amountremaining}</td>
				</tr>
			</table>
		</#if>
	</#if>

	<#if record.custbody_alcq_prnt_proforma_inv?string("true", "false") == "false">
		<table class="specialinstruct" style="width:100%; height:60px;">
			<tr>
				<td class="specialinstruct"><span style="color:#4d4d4d; font-weight: bold; font-size: 8pt;">SPECIAL INSTRUCTIONS: &nbsp;&nbsp;</span><br /><br />${record.createdfrom}<br /><span style="color:#4d4d4d; font-size: 8pt;">${record.message}</span><br />&nbsp;</td>
			</tr>
		</table>
	</#if>
</body>
</pdf>